<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色语义笔刷:键集必须与 Light.xaml 完全一致(运行时会做一致性自检)。
         状态色(支出红/收入绿/逾期橙)对深底提亮以保证对比可读。 -->
    <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PanelBg" Color="#242424" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0" />
    <SolidColorBrush x:Key="TextMuted" Color="#8C8C8C" />
    <SolidColorBrush x:Key="TextSection" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Divider" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BorderLine" Color="#404040" />
    <SolidColorBrush x:Key="ControlTrack" Color="#333333" />
    <SolidColorBrush x:Key="Expense" Color="#E57373" />
    <SolidColorBrush x:Key="Income" Color="#81C784" />
    <SolidColorBrush x:Key="Error" Color="#E57373" />
    <SolidColorBrush x:Key="Success" Color="#81C784" />
    <SolidColorBrush x:Key="Warn" Color="#FFB74D" />
    <SolidColorBrush x:Key="CalendarBlankCell" Color="#1B1B1B" />
</ResourceDictionary>
