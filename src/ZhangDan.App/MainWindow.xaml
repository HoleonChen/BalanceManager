<Window x:Class="ZhangDan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账单管理"
        Height="780" Width="1200"
        MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#F4F6F8">
            <DockPanel Margin="0,18,0,12">
                <TextBlock DockPanel.Dock="Top" Text="账单管理" FontSize="22" FontWeight="SemiBold"
                           Margin="20,0,12,4" Foreground="#1F1F1F"/>
                <TextBlock DockPanel.Dock="Top" x:Name="_ledgerNameText" Text="未打开账本"
                           Margin="20,0,12,18" Foreground="#8A8A8A" TextWrapping="Wrap" FontSize="12"/>

                <StackPanel x:Name="_navPanel">
                    <Button x:Name="_navDay"   Tag="day"      Content="📒  今日记账" Click="Nav_Click"
                            HorizontalContentAlignment="Left" Height="42" Padding="18,0,0,0"
                            Background="Transparent" BorderThickness="0" FontSize="15"/>
                    <Button Tag="flow"     Content="🧾  流水" Click="Nav_Click"
                            HorizontalContentAlignment="Left" Height="42" Padding="18,0,0,0"
                            Background="Transparent" BorderThickness="0" FontSize="15"/>
                    <Button Tag="periods"  Content="🗓️  周期" Click="Nav_Click"
                            HorizontalContentAlignment="Left" Height="42" Padding="18,0,0,0"
                            Background="Transparent" BorderThickness="0" FontSize="15"/>
                    <Button Tag="accounts" Content="🏦  账户" Click="Nav_Click"
                            HorizontalContentAlignment="Left" Height="42" Padding="18,0,0,0"
                            Background="Transparent" BorderThickness="0" FontSize="15"/>
                    <Button Tag="categories" Content="🏷️  分类" Click="Nav_Click"
                            HorizontalContentAlignment="Left" Height="42" Padding="18,0,0,0"
                            Background="Transparent" BorderThickness="0" FontSize="15"/>
                    <Button x:Name="_navSettings" Tag="settings" Content="⚙️  设置" Click="Nav_Click"
                            HorizontalContentAlignment="Left" Height="42" Padding="18,0,0,0"
                            Background="Transparent" BorderThickness="0" FontSize="15"/>

                    <Separator Margin="14,14,14,12" Background="#D8DEE3"/>
                    <Button x:Name="_fileBtn" Tag="file" Click="FileAction_Click"
                            HorizontalContentAlignment="Left" Height="40" Padding="18,0,0,0"
                            Background="Transparent" BorderThickness="0" FontSize="14"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="_content"/>

            <!-- 未打开账本时的启动面板 -->
            <Grid x:Name="_startPanel" Background="#FAFBFD" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <TextBlock Text="账单管理" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#1F1F1F"/>
                    <TextBlock Text="离线个人账本 · SQLCipher 加密" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,0,0,28" Foreground="#8A8A8A"/>
                    <Button Content="新建账本…" Height="46" FontSize="15" Margin="0,0,0,12" Click="NewLedger_Click"/>
                    <Button Content="打开已有账本…" Height="46" FontSize="15" Click="OpenLedger_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
