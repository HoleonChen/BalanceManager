<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- mac 上做跨平台编译检查需要;Windows 上无副作用 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- 发布目标:自包含 win-x64 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <RootNamespace>ZhangDan</RootNamespace>
    <AssemblyName>账单管理</AssemblyName>
    <!-- SystemAware:单显示器高 DPI 下配合 FormBase 的 96 基准按 1.5 精确缩放一次;
         PerMonitorV2 会叠加框架自动缩放,导致代码直排控件被二次放大(实测按钮过大/顶栏被挤) -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 业务/数据层已抽到 ZhangDan.Core(本工程为过渡期 UI 壳,仅保留 WinForms 界面) -->
    <ProjectReference Include="..\ZhangDan.Core\ZhangDan.Core.csproj" />
  </ItemGroup>

</Project>
